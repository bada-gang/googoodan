# Firebase 설정 (서버 저장을 쓸 때만 필요)
#
# 1. https://console.firebase.google.com 에서 프로젝트를 만든다
# 2. 프로젝트 설정 → 내 앱 → 웹 앱 추가 → 표시되는 값을 아래에 붙여 넣는다
# 3. 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local 은 git 에 올라가지 않는다)
#
# 값이 하나라도 비어 있으면 게임은 이 기기(localStorage)에만 저장한다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 선생님 화면(/teacher.html) 암호
#
# ⚠ 보안 장치가 아니다. 이 값은 브라우저로 내려가는 파일 안에 그대로 들어간다.
#   학생이 주소를 눌러 우연히 들어오는 것을 막는 정도로만 쓴다.
# 비워 두면 암호 없이 바로 열린다.

VITE_TEACHER_PASSCODE=
